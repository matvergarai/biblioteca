{
	"info": {
		"name": "Foro - Usuarios",
		"description": "CRUD de usuarios e inicio de sesion. Roles: USUARIO y ADMINISTRADOR.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080"
		},
		{
			"key": "usuarioId",
			"value": "1"
		}
	],
	"item": [
		{
			"name": "Crear usuario",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"if (pm.response.code === 201) {",
							"    pm.collectionVariables.set('usuarioId', pm.response.json().id);",
							"}"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"nombre\": \"Ana Perez\",\n  \"correo\": \"ana@foro.cl\",\n  \"clave\": \"secreto\",\n  \"rol\": \"USUARIO\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": "{{baseUrl}}/usuarios"
			}
		},
		{
			"name": "Crear administrador",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"nombre\": \"Admin Foro\",\n  \"correo\": \"admin@foro.cl\",\n  \"clave\": \"secreto\",\n  \"rol\": \"ADMINISTRADOR\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": "{{baseUrl}}/usuarios"
			}
		},
		{
			"name": "Iniciar sesion",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"correo\": \"ana@foro.cl\",\n  \"clave\": \"secreto\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": "{{baseUrl}}/usuarios/login"
			}
		},
		{
			"name": "Listar usuarios",
			"request": {
				"method": "GET",
				"header": [],
				"url": "{{baseUrl}}/usuarios"
			}
		},
		{
			"name": "Obtener usuario por ID",
			"request": {
				"method": "GET",
				"header": [],
				"url": "{{baseUrl}}/usuarios/{{usuarioId}}"
			}
		},
		{
			"name": "Actualizar usuario",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"nombre\": \"Ana Perez\",\n  \"correo\": \"ana@foro.cl\",\n  \"rol\": \"USUARIO\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": "{{baseUrl}}/usuarios/{{usuarioId}}"
			}
		},
		{
			"name": "Listar categorias",
			"request": {
				"method": "GET",
				"header": [],
				"url": "{{baseUrl}}/categorias"
			}
		},
		{
			"name": "Eliminar usuario",
			"request": {
				"method": "DELETE",
				"header": [],
				"url": "{{baseUrl}}/usuarios/{{usuarioId}}"
			}
		}
	]
}
